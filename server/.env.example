# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Qdrant Cloud cluster URL, e.g. https://xxxxxxxx.cloud.qdrant.io
QDRANT_URL=
# Qdrant Cloud API key (from your Qdrant Cloud cluster's API keys page)
QDRANT_API_KEY=

# Optional overrides — defaults shown
QDRANT_COLLECTION=blood_buddy_demo_v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional shared key for local staff collection confirmation
COLLECTION_STAFF_KEY=

WAVE_SECONDS=45
INVITE_SECONDS=90
WAVE_RADIUS_KM=15
DONOR_COOLDOWN_SECONDS=900
DONOR_DAILY_LIMIT=3
